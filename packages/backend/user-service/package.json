{
	"name": "@speak-up/user-service",
	"version": "1.0.0",
	"description": "User Service - Profile management, friends, settings, GDPR",
	"main": "dist/index.js",
	"scripts": {
		"prepare": "test -n \"$PRISMA_SKIP_POSTINSTALL_GENERATE\" || prisma generate --schema=../../shared/prisma/schema.prisma",
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "eslint src --ext .ts"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.1",
		"@fastify/helmet": "^12.0.1",
		"@fastify/multipart": "^9.0.1",
		"@fastify/static": "^8.0.4",
		"@prisma/client": "^6.0.0",
		"@speak-up/shared": "file:../../shared/types",
		"fastify": "^5.2.0",
		"ioredis": "^5.4.2",
		"jsonwebtoken": "^9.0.2",
		"pino": "^9.5.0",
		"pino-pretty": "^13.0.0",
		"uuid": "^11.0.3"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^22.10.2",
		"@types/uuid": "^10.0.0",
		"prisma": "^6.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"prisma": {
		"schema": "../../shared/prisma/schema.prisma"
	}
}
