# ft_transcendence Environment Variables Example
# Copy this file to .env and fill in your values
# Note: This project primarily uses HashiCorp Vault for secret management
# The secrets are generated automatically with `make setup` or `scripts/generate_dev_secrets.sh`

# =====================================
# Database Configuration
# =====================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=root_admin
DB_NAME=game_db
# DB_PASSWORD is managed via Docker secrets (infra/secret/postgres_db_pass.txt)

# =====================================
# Redis Configuration
# =====================================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is managed via Docker secrets (infra/secret/redis_password.txt)

# =====================================
# Vault Configuration
# =====================================
VAULT_ADDR=http://vault:8200
# VAULT_TOKEN is managed via Docker secrets (infra/secret/vault_token.txt)

# =====================================
# OAuth 2.0 Configuration (42 Intra)
# =====================================
# These credentials are stored in HashiCorp Vault for security
# Configure them in Vault at: secret/data/oauth/42
OAUTH_42_CLIENT_ID=your_42_client_id
OAUTH_42_CLIENT_SECRET=your_42_client_secret
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/auth/callback/42

# =====================================
# JWT Configuration
# =====================================
# JWT_SECRET is managed via Docker secrets (infra/secret/jwt_secret.txt)
# SESSION_SECRET is managed via Docker secrets (infra/secret/session_secret.txt)

# =====================================
# Service Configuration
# =====================================
NODE_ENV=development
LOG_LEVEL=info

# API Gateway
API_GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
GAME_SERVICE_URL=http://game-service:3003
GAMIFICATION_SERVICE_URL=http://gamification-service:3004

# Auth Service
AUTH_SERVICE_PORT=3001

# User Service
USER_SERVICE_PORT=3002

# Game Service
GAME_SERVICE_PORT=3003
GAME_TICK_RATE=20
SESSION_TIMEOUT=3600000
RECONNECT_WINDOW=30000

# Gamification Service
GAMIFICATION_SERVICE_PORT=3004

# =====================================
# Monitoring Configuration (Optional)
# =====================================
# Grafana credentials are in infra/secret/grafana_pass.txt
# Uptime Kuma credentials are in infra/secret/kuma_pass.txt

# =====================================
# Frontend Configuration
# =====================================
VITE_API_URL=https://localhost:8443/api
